# Frontend Variables (Shared with Browser)
VITE_NEXT_PUBLIC_APP_ENV=local
# WARNING: Must stay false in production (Supabase-backed deploy); true enables the local dev auth bypass.
VITE_USE_LOCAL_DB=false

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend / Server Variables (Secrets - NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GEMINI_API_KEY=your_gemini_api_key

# EmailJS (server-side only — used by /api/send-report-email).
# The old VITE_EMAILJS_* client vars are no longer used; report email now goes
# through the authenticated backend proxy so these IDs stay out of the browser.
# Requires "Allow EmailJS API for non-browser applications" enabled in the
# EmailJS dashboard (Account -> Security) for the private-key REST call to work.
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
